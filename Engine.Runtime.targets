<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CheckBundledDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(EnginePhysicsLibDir)reactphysics3d.lib') Or !Exists('$(EngineLuaLibDir)lua53.lib') Or !Exists('$(EngineAssimpLibDir)$(EngineAssimpLibrary)') Or !Exists('$(EngineAssimpDll)')"
           Text="Bundled $(Configuration) dependencies are missing. Restore the $(Configuration)\lib and bin files under Dependencies\Assimp, LUA and ReactPhysics3D. A complete checkout builds directly; see BUILDING.md." />
  </Target>
  <Target Name="CopyEditorRuntime" AfterTargets="Build">
    <ItemGroup>
      <EditorRuntimeDll Include="$(EngineRoot)Dependencies\SDL\lib\SDL2.dll" />
      <EditorRuntimeDll Include="$(EngineRoot)Dependencies\SDL\lib\SDL2_mixer.dll" />
      <EditorRuntimeDll Include="$(EngineAssimpDll)" />
      <EditorOptionalDll Include="$(EngineRoot)Dependencies\SDL\lib\optional\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorRuntimeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorOptionalDll)" DestinationFolder="$(TargetDir)optional\" SkipUnchangedFiles="true" Condition="'@(EditorOptionalDll)'!=''" />
  </Target>
</Project>
