<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CheckReleaseDependencies" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)'=='Release'">
    <Error Condition="!Exists('$(EngineReleaseLibDir)reactphysics3d.lib') Or !Exists('$(EngineReleaseLibDir)lua53.lib') Or !Exists('$(EngineReleaseLibDir)assimp-vc143-mt.lib') Or !Exists('$(EngineAssimpDll)')"
           Text="Bundled Release dependencies are missing from Dependencies\Release. Restore the repository's lib and bin files; a complete checkout builds directly without rebuilding third-party libraries. See BUILDING.md." />
  </Target>
  <Target Name="CopyEditorRuntime" AfterTargets="Build">
    <ItemGroup>
      <EditorRuntimeDll Include="$(EngineRoot)Dependencies\SDL\lib\SDL2.dll" />
      <EditorRuntimeDll Include="$(EngineRoot)Dependencies\SDL\lib\SDL2_mixer.dll" />
      <EditorRuntimeDll Include="$(EngineAssimpDll)" />
      <EditorOptionalDll Include="$(EngineRoot)Dependencies\SDL\lib\optional\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorRuntimeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorOptionalDll)" DestinationFolder="$(TargetDir)optional\" SkipUnchangedFiles="true" Condition="'@(EditorOptionalDll)'!=''" />
  </Target>
</Project>
