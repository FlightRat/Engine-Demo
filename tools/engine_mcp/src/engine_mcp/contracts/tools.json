          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Required display name for each new object; names may repeat."
          },
          "kind": {
            "type": "string",
            "enum": [
              "mesh",
              "light"
            ],
            "description": "Required object kind."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Required for mesh: an exact loaded model key from list_assets. Omit for light."
          }
        },
