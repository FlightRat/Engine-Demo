    {
      "name": "apply_operations",
      "description": "Atomically apply 1..32 actions in the current scene. Each item has method and params. create_object params require name and kind; mesh also requires model (the loaded asset key). Example creation: {\"method\":\"create_object\",\"params\":{\"name\":\"Display Model\",\"kind\":\"mesh\",\"model\":\"cube\",\"client_ref\":\"model\"}}. For a light use name, kind=light and optional client_ref. Later set_transform/set_light params use entity_id OR an earlier creation's target_ref, plus the fields to update. One revision and one single-level undo record; no scene creation inside a batch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "scene_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "create_object"
                      ]
                    },
                    "params": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "description": "Required display name for each new object; names may repeat."
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "mesh",
                            "light"
                          ],
                          "description": "Required object kind."
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "description": "Required for mesh: an exact loaded model key from list_assets. Omit for light."
                        },
                        "client_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "name",
                        "kind"
                      ],
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "properties": {
                            "kind": {
                              "enum": [
                                "mesh"
                              ]
                            }
                          },
                          "required": [
                            "model"
                          ]
                        },
                        {
                          "properties": {
                            "kind": {
                              "enum": [
                                "light"
                              ]
                            }
                          },
                          "not": {
                            "required": [
                              "model"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "method",
                    "params"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "set_transform"
                      ]
                    },
                    "params": {
                      "type": "object",
                      "properties": {
                        "entity_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "space": {
                          "type": "string",
                          "enum": [
                            "local"
                          ]
